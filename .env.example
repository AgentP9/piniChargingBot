# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://192.168.1.100:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Topic Configuration
# You can now define devices with custom names and MQTT topics
# New format: "Device Name:mqtt/topic,Another Device:another/topic"
# Examples:
#   MQTT_DEVICES=Office Charger:shellies/shellyplug07,Kitchen Charger:shellies/shellyplug02
#   MQTT_DEVICES=Living Room:home/plugs/living-room,Garage:home/plugs/garage
# 
# Legacy format (backward compatible): "deviceId,deviceId2"
# Example: MQTT_DEVICES=shellyplug-s-12345,shellyplug-s-67890
#
# Each device will subscribe to: {topic}/relay/0 and {topic}/relay/0/power
MQTT_DEVICES=Office Charger:shellies/shellyplug07,Kitchen Charger:shellies/shellyplug02

# Appliance Monitoring (optional)
# Configure appliances like washing machines or dishwashers whose power you want to monitor.
# Unlike chargers, appliances are NEVER switched off automatically.
# Instead, a cycle start is detected when power rises above a threshold (default: 10 W)
# and a cycle end is detected when power stays below that threshold for 5 minutes.
# When a cycle ends, a JSON notification is published to the configured MQTT notify topic.
#
# Format: "Name:powerTopic" or "Name:powerTopic:notifyTopic"
#   - powerTopic  : MQTT topic prefix; subscribes to {powerTopic}/relay/0/power
#   - notifyTopic : where to publish the cycle-complete notification
#                   (defaults to {powerTopic}/notify if omitted)
#
# Notification payload (JSON):
#   { "event": "cycle_complete", "applianceName": "...", "applianceId": "...",
#     "processId": 42, "startTime": "...", "endTime": "...", "durationMinutes": 78.0 }
#
# Examples:
#   MQTT_APPLIANCES=Washing Machine:shellies/washer
#   MQTT_APPLIANCES=Washing Machine:shellies/washer,Dishwasher:shellies/dish:home/alerts/dishwasher
MQTT_APPLIANCES=
